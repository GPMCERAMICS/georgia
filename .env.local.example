# Copy to .env.local and fill in. Never commit .env.local.

# Resend API key — create one at https://resend.com (free tier).
RESEND_API_KEY=

# Where commission inquiries are delivered.
CONTACT_TO_EMAIL=hello@georgiaperkinspottery.com

# From address. Until you verify a domain in Resend, you can use:
#   Commissions <onboarding@resend.dev>
# After verifying georgiaperkinspottery.com, switch to an address on it.
CONTACT_FROM_EMAIL=Commissions <onboarding@resend.dev>

# Canonical site URL (used for SEO metadata, sitemap, JSON-LD).
NEXT_PUBLIC_SITE_URL=https://georgiaperkinspottery.com

# Convex — written automatically by `npx convex dev`
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Admin — the only email allowed to sign in to /admin
ADMIN_EMAIL=
