# Copy to .env.local and fill in. Never commit .env.local.
#
# Two places hold configuration:
#   • This file / Vercel   — what the Next.js app needs.
#   • Convex dashboard     — what the backend needs (see the second block).
#     Set those with `npx convex env set NAME value`.

# ---------- Next.js (this file, and Vercel project settings) ----------

# Written automatically by `npx convex dev`.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Canonical site URL (SEO metadata, sitemap, JSON-LD).
NEXT_PUBLIC_SITE_URL=https://www.gpmceramics.com

# ---------- Convex deployment env (npx convex env set …) ----------

# Comma-separated list of emails allowed to sign in to /admin.
ADMIN_EMAIL=

# Stripe. Use test keys (sk_test_…) until launch.
STRIPE_SECRET_KEY=
# From the webhook endpoint you create in Stripe pointing at
#   https://<deployment>.convex.site/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# Resend, for order emails, inquiry notifications, and password reset codes.
RESEND_API_KEY=
# Until a domain is verified in Resend, only onboarding@resend.dev works and it
# can only deliver to the Resend account owner's inbox.
RESEND_FROM_EMAIL=Georgia Perkins Pottery <onboarding@resend.dev>

# Where Stripe sends buyers back to after checkout.
SITE_URL=https://www.gpmceramics.com
